timestamp=2026-11-15T06:59:33.507Z level=INFO run=24e8f730 message=evaluated permission=bash pattern="cat >> gears.py <<'EOF'\ndef frac(x): return x-math.floor(x)\ndef mate_phase(th1,z1,p1,p2,z2):\n    \"\"\"tooth-centre angle (deg) for gear2 meshing gear1 (tooth angle th1).\"\"\"\n    psi=math.degrees(math.atan2(p2[1]-p1[1],p2[0]-p1[0]))\n    u1=frac((psi-th1)*z1/360.0)\n    return psi+180.0-(0.5-u1)*360.0/z2\ndef phased(cs,z,th):\n    return cs.rotate(th-(90.0+180.0/z))\nEOF" action.permission=* action.action=allow action.pattern=*
timestamp=2026-11-15T06:59:33.507Z level=INFO run=24e8f730 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport sys; sys.path.insert(0,'/app/tools'); import kernel, gears, numpy as np, manifold3d as m3, trimesh, math\nbm=trimesh.load('/app/supplied/BR-096-30.stl')\nB=m3.Manifold(m3.Mesh(vert_properties=np.asarray(bm.vertices,np.float32),tri_verts=np.asarray(bm.faces,np.uint32)))\nprint(B.volume())\nC=np.array([2.8,0.]);O=np.zeros(2)\nfor z,R,pos in ((9,10.5,None),(12,10.8,None)):\n    # place at angle from earlier\n    pos={9:np.array([8.4875,6.18161336]),12:np.array([9.62857143,4.8918925])}[z]\n    th=gears.mate_phase(0.0,96,O,pos,z)\n    cs=gears.phased(gears.gear_cs(z,0.2,s=0.284),z,th)\n    P=m3.Manifold.extrude(cs,0.4545).translate([pos[0],pos[1],0])\n    worst=1\n    for k in range(25):\n        a=k*3.75/24  # barrel cw rotation deg\n        Bk=B.rotate([0,0,-a])\n        Pk=P.translate([-pos[0],-pos[1],0]).rotate([0,0,a*96/z]).translate([pos[0],pos[1],0])\n        iv=kernel.ivol(Bk,Pk); g=Bk.min_gap(Pk,0.2)\n        worst=min(worst,g); \n        if iv>0: print('ivol',k,iv)\n    print(z,'min gap',worst)\nEOF" action.permission=* action.action=allow action.pattern=*
