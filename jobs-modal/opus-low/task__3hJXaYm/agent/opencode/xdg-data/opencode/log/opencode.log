timestamp=2026-11-15T07:06:10.212Z level=INFO run=24e8f730 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport sys; sys.path.insert(0,'.'); sys.path.insert(0,'/app/tools')\nimport gears, kernel, numpy as np, manifold3d as m3, math\ndef test(z1,m,z2,thin=0.035,steps=40):\n    a=m*(z1+z2)/2\n    g1=gears.gear_cs(z1,m,thin=thin); g2=gears.gear_cs(z2,m,thin=thin)\n    th1=0; th2=gears.mate_phase(th1,z1,(0,0),(a,0),z2)\n    A=m3.Manifold.extrude(gears.phased(g1,z1,th1),0.2)\n    B=m3.Manifold.extrude(gears.phased(g2,z2,th2),0.2).translate([a,0,0])\n    worst=9; maxiv=0\n    for k in range(steps):\n        d=360/z1*k/steps\n        X=A.rotate([0,0,d]); Y=B.translate([-a,0,0]).rotate([0,0,-d*z1/z2]).translate([a,0,0])\n        iv=kernel.ivol(X,Y); maxiv=max(maxiv,iv)\n        if iv<1e-9: worst=min(worst,X.min_gap(Y,0.1))\n    print(z1,z2,m,'maxiv',maxiv,'mingap',worst)\ntest(8,0.15,64); test(8,0.15,32); test(8,0.1875,24); test(12,0.15,48); test(10,0.15,64)\nEOF" action.permission=* action.action=allow action.pattern=*
